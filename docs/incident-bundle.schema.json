{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchtrace.local/schemas/incident-bundle-v1.json",
  "title": "PatchTrace incident bundle",
  "description": "A local, versioned description of an incident and the evidence used to rank candidate changes.",
  "type": "object",
  "required": ["schemaVersion", "title", "environment", "incidentStart", "commits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "environment": { "type": "string", "minLength": 1 },
    "incidentStart": { "$ref": "#/$defs/timestamp" },
    "incidentEnd": { "$ref": "#/$defs/timestamp" },
    "candidateWindowMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "incidentFiles": {
      "description": "Non-empty incident file evidence enables per-candidate file-overlap evaluation when that candidate also supplies changedFiles. An absent or empty array leaves the signal unavailable.",
      "type": "array",
      "maxItems": 5000,
      "items": { "type": "string", "minLength": 1 }
    },
    "commits": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["sha", "timestamp", "message"],
        "properties": {
          "sha": { "$ref": "#/$defs/sha" },
          "timestamp": { "$ref": "#/$defs/timestamp" },
          "message": { "type": "string", "minLength": 1 },
          "changedFiles": {
            "description": "Repository-relative paths. Omission means this candidate lacks file/test overlap evidence; an explicit empty array is observed no-changed-file evidence.",
            "type": "array",
            "maxItems": 5000,
            "items": { "type": "string", "minLength": 1 }
          },
          "diffRisk": { "type": "number", "minimum": 0, "maximum": 1 },
          "diffRiskSource": { "type": "string" },
          "dependencyImpact": { "type": "number", "minimum": 0, "maximum": 1 },
          "dependencyImpactSource": { "type": "string" }
        }
      }
    },
    "deployments": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["timestamp", "environment"],
        "anyOf": [
          { "required": ["commitSha"] },
          { "required": ["commitShas"] }
        ],
        "properties": {
          "commitSha": { "$ref": "#/$defs/sha" },
          "commitShas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": { "$ref": "#/$defs/sha" }
          },
          "timestamp": { "$ref": "#/$defs/timestamp" },
          "environment": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "timestamp": {
            "description": "Optional source-provided test timestamp. Ingestion does not substitute incidentStart when this field is absent.",
            "$ref": "#/$defs/timestamp"
          },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "relatedFiles": {
            "description": "Files connected to the test. For failing tests, omission leaves candidate test-overlap unavailable; an explicit empty array is observed no-related-file evidence.",
            "type": "array",
            "maxItems": 5000,
            "items": { "type": "string", "minLength": 1 }
          },
          "errorSignature": { "type": "string" }
        }
      }
    },
    "incidentEvents": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["kind", "timestamp", "title"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "timestamp": { "$ref": "#/$defs/timestamp" },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "commitSha": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "Optional fixture-only verification evidence. Real verification is requested separately and is not trusted from the bundle.",
      "propertyNames": { "pattern": "^[0-9a-fA-F]{4,64}$" },
      "additionalProperties": { "type": "object" }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "ingestion": {
          "type": "object",
          "properties": {
            "ingestedAt": { "type": "string" },
            "parserVersion": { "type": "string" },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind", "sha256", "parser", "parserVersion", "ingestedAt"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": { "type": "string", "minLength": 1 },
                  "sourcePath": { "type": ["string", "null"] },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "parser": { "type": "string", "minLength": 1 },
                  "parserVersion": { "type": "string", "minLength": 1 },
                  "ingestedAt": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "(Z|[+-][0-9]{2}:?[0-9]{2})$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{4,64}$"
    }
  }
}
