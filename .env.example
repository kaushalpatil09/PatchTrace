# Bind address. Keep 127.0.0.1 unless you deliberately expose the server.
HOST=127.0.0.1
PORT=4173

# Real repository verification is disabled unless this is 1.
PATCHTRACE_ENABLE_VERIFY=0

# Comma-separated extra hostnames allowed in Host/Origin checks.
PATCHTRACE_ALLOWED_HOSTS=

# Comma-separated environment variable allowlist for verification commands.
PATCHTRACE_VERIFY_ENV=

# Optional fixed API token. If empty, a random token is generated per start.
PATCHTRACE_TOKEN=

# Real verification isolation. Keep temp-copy for trusted previews;
# production requires an existing Docker/Podman runtime and local image.
PATCHTRACE_VERIFY_ISOLATION=temp-copy
PATCHTRACE_CONTAINER_RUNTIME=
PATCHTRACE_VERIFY_IMAGE=patchtrace:local
PATCHTRACE_VERIFY_USER=65532:65532
PATCHTRACE_VERIFY_CPUS=1
PATCHTRACE_VERIFY_MEMORY=512m
PATCHTRACE_VERIFY_PIDS_LIMIT=256
PATCHTRACE_VERIFY_TMPFS_SIZE=64m
PATCHTRACE_VERIFY_MAX_COPY_BYTES=2147483648
PATCHTRACE_VERIFY_MIN_FREE_BYTES=268435456
