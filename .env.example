# Bind address. Keep 127.0.0.1 unless you deliberately expose the server.
HOST=127.0.0.1
PORT=4173

# Real repository verification is disabled unless this is 1.
PATCHTRACE_ENABLE_VERIFY=0

# Comma-separated extra hostnames allowed in Host/Origin checks.
PATCHTRACE_ALLOWED_HOSTS=

# Comma-separated environment variable allowlist for verification commands.
PATCHTRACE_VERIFY_ENV=

# Optional fixed API token. If empty, a random token is generated per start.
PATCHTRACE_TOKEN=
